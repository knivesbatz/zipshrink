/* Version information shared by both programs. */
#include <winver.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
FILEVERSION ZS_VMAJ, ZS_VMIN, ZS_VPAT, 0
PRODUCTVERSION ZS_VMAJ, ZS_VMIN, ZS_VPAT, 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "ZipShrink contributors"
      VALUE "FileDescription", DESCRIPTION
      VALUE "FileVersion", ZS_VERSION
      VALUE "InternalName", INTERNAL
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", INTERNAL
      VALUE "ProductName", "ZipShrink"
      VALUE "ProductVersion", ZS_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
